# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Chave da API OpenAI (obrigatória para geração de imagens)
OPENAI_API_KEY=your_openai_api_key_here

# Modelo usado para inteligência de campanha (spec, review de nome, etc.)
OPENAI_MODEL=gpt-4o-mini

# ─── Provedor de Geração de Imagens (Phase 4.3.3) ──────────────────────────
# Provedor ativo para geração de imagens.
# Opções: "openai" (padrão), "gemini" (futuro — não implementado)
IMAGE_PROVIDER=openai

# Modelo usado para geração de imagens via responses.create()
# Padrão: gpt-5.5
# IMAGE_GENERATION_RESPONSES_MODEL=gpt-5.5

# Modelo usado para revisão visual das imagens geradas (visão/quality review)
# Padrão: gpt-4o
# VISION_REVIEW_MODEL=gpt-4o

# Timeout global para geração de imagens em milissegundos
# Padrão: 300000 (5 minutos)
# IMAGE_GENERATION_GLOBAL_TIMEOUT_MS=300000

# ─── Gemini (futuro — não implementado) ─────────────────────────────────────
# IMAGE_PROVIDER=gemini
# GOOGLE_API_KEY=sua_chave_google_aqui

# ─── Site URL (obrigatória para signup e recovery) ──────────────────────────
# Usada como base para emailRedirectTo e redirectTo no fluxo de confirmação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Chave da API OpenAI (obrigatória para geração de imagens)
OPENAI_API_KEY=your_openai_api_key_here

# Modelo usado para inteligência de campanha (spec, review de nome, etc.)
OPENAI_MODEL=gpt-4o-mini

# ─── Provedor de Geração de Imagens (Phase 4.3.3) ──────────────────────────
# Provedor ativo para geração de imagens.
# Opções: "openai" (padrão), "gemini" (futuro — não implementado)
IMAGE_PROVIDER=openai

# Modelo usado para geração de imagens via responses.create()
# Padrão: gpt-5.5
# IMAGE_GENERATION_RESPONSES_MODEL=gpt-5.5

# Modelo usado para revisão visual das imagens geradas (visão/quality review)
# Padrão: gpt-4o
# VISION_REVIEW_MODEL=gpt-4o

# Timeout global para geração de imagens em milissegundos
# Padrão: 300000 (5 minutos)
# IMAGE_GENERATION_GLOBAL_TIMEOUT_MS=300000

# ─── Gemini (futuro — não implementado) ─────────────────────────────────────
# IMAGE_PROVIDER=gemini
# GOOGLE_API_KEY=sua_chave_google_aqui

# ─── Gemini (fallback texto) ────────────────────────────────────
# TEXT_FALLBACK_PROVIDER=gemini        # Ativar fallback Gemini para Copy Director
# GEMINI_API_KEY=                      # Chave de API Google Gemini
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite  # Modelo usado no fallback de texto

# ─── Vercel Cron (F29.3) ───────────────────────────────────────────
# Secret used to authenticate Vercel Cron requests to /api/cron/*
CRON_SECRET=your_cron_secret_here

# ─── Monthly Credits (F29.3) ─────────────────────────────────────
# Enables automatic monthly bonus credit grant
VENDEO_MONTHLY_CREDITS_ENABLED=true
# Number of bonus credits granted per cycle
VENDEO_MONTHLY_CREDITS_AMOUNT=5
# Maximum bonus balance a store can accumulate
VENDEO_MONTHLY_BONUS_CAP=10
# Minimum store age in days to be eligible
VENDEO_MONTHLY_CREDITS_MIN_STORE_AGE_DAYS=30

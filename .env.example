# ─── Site URL (obrigatória para signup e recovery) ──────────────────────────
# Usada como base para emailRedirectTo e redirectTo no fluxo de confirmação
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Chaves de API de IA (únicas configurações de IA por env-var) ───────────
# A escolha de modelo/provider NÃO é configurável por env-var: é o registry em
# código (`src/lib/ai/model-registry.ts`).
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Operacionais de geração de imagem ──────────────────────────────────────
# Timeout global para geração de imagens em milissegundos
# Padrão: 300000 (5 minutos)
IMAGE_GENERATION_GLOBAL_TIMEOUT_MS=300000
# Qualidade da geração de imagem (ex.: "auto")
IMAGE_GENERATION_QUALITY=auto
# Logs detalhados de geração (true/false)
IMAGE_GENERATION_DEBUG=false
# Habilita escrita de métricas de geração (true/false)
METRICS_ENABLED=false

# ─── Operacionais de custo (fallback de estimativa) ─────────────────────────
# Custo fallback por geração de IA (USD) quando o usage real não está disponível
VENDEO_AI_FALLBACK_COST_USD=
# Legado: custo fallback específico de geração de imagem (USD)
VENDEO_IMAGE_GENERATION_FALLBACK_COST_USD=
# Valor em USD de 1 crédito (para conversão de custo → créditos)
VENDEO_AI_CREDIT_UNIT_USD_VALUE=

# ─── Vercel Cron (F29.3) ───────────────────────────────────────────
# Secret used to authenticate Vercel Cron requests to /api/cron/*
CRON_SECRET=your_cron_secret_here

# ─── Monthly Credits (F29.3) ─────────────────────────────────────
# Enables automatic monthly bonus credit grant
VENDEO_MONTHLY_CREDITS_ENABLED=true
# Number of bonus credits granted per cycle
VENDEO_MONTHLY_CREDITS_AMOUNT=5
# Limiar de elegibilidade do grant mensal freemium: raiz recebe grant integral enquanto bonus_balance < cap; em ou acima do limiar, não recebe no ciclo
VENDEO_MONTHLY_BONUS_CAP=10
# Minimum store age in days to be eligible
VENDEO_MONTHLY_CREDITS_MIN_STORE_AGE_DAYS=30

CNPJ_PEPPER=replace_with_64_hex_secret

{
  "$schema": "https://opencode.ai",
  "plugins": [
    ".opencode/plugins/graphify.js",
    "opencode-openai-codex-auth"
  ],
  "workspace": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/.backup-work/**",
      "**/backups/**",
      "**/storage-backup/**"
    ]
  },
  "provider": {
    "openai": {
      "options": {
        "authMethod": "oauth-codex"
      },
      "models": {
        "gpt-5.6-luna": {},
        "gpt-5.6-terra": {},
        "gpt-5.6-sol": {},
        "gpt-5.3-codex": {}
      }
    }
  }
}
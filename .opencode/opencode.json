{
  "$schema": "https://opencode.ai",
  "plugins": [
    ".opencode/plugins/graphify.js",
    "opencode-openai-codex-auth"
  ],
  "workspace": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/.backup-work/**",
      "**/backups/**",
      "**/storage-backup/**"
    ]
  },
  "model": "openai/gpt-5.6-luna-fast",
  "provider": {
    "openai": {
      "options": {
        "authMethod": "oauth-codex"
      },
      "models": {
        "gpt-5.6-luna-fast": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}
+$$;
+
+COMMENT ON FUNCTION public.trial_offer_versions_guard_delete() IS
+  'F63: rejeita DELETE de versão publicada; rascunho permanece excluível.';
+
+CREATE TRIGGER trg_trial_offer_versions_guard
